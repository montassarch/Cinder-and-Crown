# Normalize line endings so Windows checkouts don't churn the diff.
* text=auto eol=lf

# Godot text resources
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.cfg     text eol=lf

# Binary assets
*.png     binary
*.jpg     binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
