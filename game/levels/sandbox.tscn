[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://src/level/sandbox.gd" id="1_sandbox"]
[ext_resource type="PackedScene" path="res://src/player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://src/ui/hud.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://src/ui/sandbox_menu.tscn" id="4_menu"]
[ext_resource type="PackedScene" path="res://src/input/touch_controls.tscn" id="5_touch"]
[ext_resource type="Script" path="res://src/ui/debug_overlay.gd" id="6_debug"]
[ext_resource type="PackedScene" path="res://src/ui/controls_help.tscn" id="7_help"]

[node name="Sandbox" type="Node2D"]
script = ExtResource("1_sandbox")

; Geometry is built at runtime by sandbox.gd from tile-space rectangles,
; never authored as pixels here. See WorldBuilder for why: hand-placed
; pixel geometry silently breaks the TILE_SIZE upgrade path, because the
; player scales and the floor does not.
[node name="World" type="StaticBody2D" parent="."]
unique_name_in_owner = true
collision_layer = 1
collision_mask = 0

[node name="Visuals" type="Node2D" parent="."]
unique_name_in_owner = true

[node name="PlayerSpawn" type="Marker2D" parent="."]
unique_name_in_owner = true

[node name="Player" parent="." instance=ExtResource("2_player")]
unique_name_in_owner = true

[node name="Camera2D" type="Camera2D" parent="Player"]
limit_left = 0
limit_top = 0
limit_right = 768
limit_bottom = 216
position_smoothing_enabled = true
position_smoothing_speed = 8.0

[node name="Enemies" type="Node2D" parent="."]
unique_name_in_owner = true

[node name="DebugOverlay" type="Node2D" parent="."]
unique_name_in_owner = true
visible = false
z_index = 100
script = ExtResource("6_debug")

[node name="HUD" parent="." instance=ExtResource("3_hud")]
unique_name_in_owner = true

[node name="SandboxMenu" parent="." instance=ExtResource("4_menu")]
unique_name_in_owner = true

[node name="ControlsHelp" parent="." instance=ExtResource("7_help")]
unique_name_in_owner = true

[node name="TouchControls" parent="." instance=ExtResource("5_touch")]
